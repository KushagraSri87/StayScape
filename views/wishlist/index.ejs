<% layout("/layouts/boilerplate") -%>

<div class="row">
  <div class="col-10 offset-1 mt-3">
    <h3>My Wishlist</h3>

    <% if(wishlist.length === 0) { %>
      <p class="text-muted">Nothing saved yet - browse <a href="/listings">listings</a> and tap Save on ones you like.</p>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-3 g-4 mt-2">
        <% for(let listing of wishlist) { %>
          <div class="col">
            <div class="card h-100 listing-card">
              <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                <img src="<%= listing.image.url %>" class="card-img-top show-image" alt="listing image">
                <div class="card-body">
                  <p class="card-text"><b><%= listing.title %></b></p>
                  <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %> /Night</p>
                </div>
              </a>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>